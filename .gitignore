.DS_Store
*raw
*.pt
*.mp4
*.gz
*.pth
*.pt
*.meta
data_*
*_batch*
.trunk
venv
__pycache__
old_outputs
YOLO/augmented_dataset
# Cached latent/mask arrays. Regenerated on demand and invalidated by a
# fingerprint, and multi-GB: never worth versioning.
*.npy
latent_cache/
YOLO/outputs/diffusion_test_eval_glad-dove/diffusion_dataset
# Evaluator artifacts: every run writes thousands of composite images plus
# per-sample telemetry. Archived by run_eval.sh into evaluator/old_*.
evaluator/outputs/*
evaluator/telemetry_logs/*
# Upload interface artifacts: one folder per upload, staged masks plus panels.
frontend/uploads/*
frontend/outputs/*
# missing_yolo artifacts: per-epoch overlays/montages plus telemetry CSVs
# (one per run id). Archived by train_missing_yolo.sh into missing_yolo/old_*.
missing_yolo/outputs/*
missing_yolo/telemetry_logs/*
# Standalone validation reports: the small metrics/tables/CSVs are versioned,
# but the regenerated val dataset, Ultralytics curves/saved labels and sample
# PNGs stay local. Archived by validate_missing_yolo.sh into
# missing_yolo/old_validation_outputs/.
missing_yolo/validation_outputs/*/dataset/
missing_yolo/validation_outputs/*/ultralytics/
missing_yolo/validation_outputs/*/samples/
missing_yolo/old_validation_outputs/*

# --- Wall / door / window model (Reconstruction/) ---
# Large local files, kept next to the code but not versioned (see README: Data and weights).
datasets/resplan/12/ResPlan.pkl
datasets/processed/*/train/plans.jsonl
.pytest_cache/
# ...except the serve-only weights of the two FurnitureArranger profiles and the small example stores they ship with.
!Reconstruction/serve/weights/*.pt
!datasets/processed/furniture/examples/*.npy
!datasets/processed/furniture_shell/examples/*.npy

# Local archives and scratch
*.zip
.DS_Store

# Logs and archived runs: regenerated by every run (the run scripts archive the previous run into old_*).
debug_logs/
old_telemetry_logs/
*/old_telemetry_logs/
old_outputs/
*/old_outputs/
YOLO/outputs/
!Reconstruction/data_prep/
